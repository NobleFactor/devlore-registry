{
  "$defs": {
    "edge": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "node": {
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations holds extensible metadata (serialized to receipts).",
          "type": "object"
        },
        "error": {
          "description": "Error message if status is failed.",
          "type": "string"
        },
        "id": {
          "description": "ID is the unique identifier (typically relative target path or package name).",
          "type": "string"
        },
        "layer": {
          "description": "Layer is the repository layer (base, team, personal).",
          "type": "string"
        },
        "operations": {
          "description": "Pipeline of operations to execute",
          "items": {
            "enum": [
              "backup",
              "copy",
              "decrypt",
              "launchd-disable",
              "launchd-enable",
              "launchd-restart",
              "launchd-start",
              "launchd-stop",
              "link",
              "move",
              "package-install",
              "package-remove",
              "package-update",
              "package-upgrade",
              "powershell",
              "remove",
              "render",
              "shell",
              "systemd-disable",
              "systemd-enable",
              "systemd-restart",
              "systemd-start",
              "systemd-stop",
              "unlink",
              "validate",
              "winservice-disable",
              "winservice-enable",
              "winservice-restart",
              "winservice-start",
              "winservice-stop",
              "write"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "description": "Project this node belongs to.",
          "type": "string"
        },
        "slots": {
          "additionalProperties": {
            "$ref": "#/$defs/slot_value"
          },
          "description": "Input slots for this node (name -\u003e value)",
          "type": "object"
        },
        "source_checksum": {
          "description": "SourceChecksum is the SHA256 of the source file at deploy time.",
          "type": "string"
        },
        "status": {
          "description": "Status of this node: pending, completed, skipped, failed.",
          "enum": [
            "pending",
            "completed",
            "skipped",
            "failed"
          ],
          "type": "string"
        },
        "target_checksum": {
          "description": "TargetChecksum is the SHA256 of the target file after deployment.",
          "type": "string"
        },
        "timestamp": {
          "description": "Timestamp is when this operation completed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "operations"
      ],
      "type": "object"
    },
    "slot_value": {
      "description": "A slot value - either immediate or a promise (reference to another node)",
      "properties": {
        "immediate": {
          "description": "Immediate is the direct value (string, used when known at analysis time).",
          "type": "string"
        },
        "node_ref": {
          "description": "NodeRef is the ID of the node that produces this value (promise).",
          "type": "string"
        },
        "slot": {
          "description": "Slot is which output slot of the referenced node (empty = default output).",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://devlore.noblefactor.com/schemas/engine-graph.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Execution graph derived from devlore-cli execution.Graph Go types",
  "properties": {
    "edges": {
      "description": "Dependencies between nodes",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "type": "array"
    },
    "nodes": {
      "description": "Operations to execute",
      "items": {
        "$ref": "#/$defs/node"
      },
      "type": "array"
    },
    "state": {
      "description": "Execution state of the graph",
      "enum": [
        "pending",
        "executed",
        "failed"
      ],
      "type": "string"
    },
    "tool": {
      "description": "Tool that created this graph",
      "type": "string"
    },
    "version": {
      "description": "Graph format version",
      "type": "string"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "Execution Graph",
  "type": "object"
}
