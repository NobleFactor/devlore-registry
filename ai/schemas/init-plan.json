{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InitPlan",
  "description": "AI-generated environment initialization plan for writ",
  "type": "object",
  "required": ["system", "recommendation", "next_steps"],
  "properties": {
    "system": {
      "type": "object",
      "description": "Detected system information",
      "required": ["platform", "architecture"],
      "properties": {
        "platform": {
          "type": "string",
          "description": "OS platform (Darwin, Linux.Debian, Linux.Fedora, Windows, etc.)"
        },
        "architecture": {
          "type": "string",
          "enum": ["arm64", "amd64"],
          "description": "CPU architecture"
        },
        "shell": {
          "type": "string",
          "description": "Default shell (bash, zsh, fish, powershell)"
        },
        "package_managers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available package managers"
        },
        "existing_dotfile_manager": {
          "type": "string",
          "description": "Detected existing dotfile manager, if any"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "Primary recommendation",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["init", "migrate"],
          "description": "Recommended action"
        },
        "reason": {
          "type": "string",
          "description": "Why this action is recommended"
        },
        "migrate_source": {
          "type": "string",
          "description": "If action is migrate, the source system to migrate from"
        }
      }
    },
    "repo_setup": {
      "type": "object",
      "description": "Repository setup recommendations (when action is init)",
      "properties": {
        "layer": {
          "type": "string",
          "enum": ["personal", "team", "base"],
          "description": "Recommended repository layer"
        },
        "layer_reason": {
          "type": "string",
          "description": "Why this layer is recommended"
        },
        "suggested_structure": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "Suggested initial directory structure"
        }
      }
    },
    "packages": {
      "type": "array",
      "description": "Recommended packages to install via lore",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Package name (from lore registry or native PM)"
          },
          "reason": {
            "type": "string",
            "description": "Why this package is recommended"
          },
          "category": {
            "type": "string",
            "enum": ["essential", "recommended", "optional"],
            "description": "How important this package is"
          },
          "platform_specific": {
            "type": "boolean",
            "description": "Whether this is platform-specific"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "description": "Suggested initial projects to create",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name"
          },
          "description": {
            "type": "string",
            "description": "What configs this project manages"
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Example files this project might contain"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "description": "Ordered list of next steps",
      "items": {
        "type": "object",
        "required": ["step", "command"],
        "properties": {
          "step": {
            "type": "string",
            "description": "Human-readable step description"
          },
          "command": {
            "type": "string",
            "description": "Command to run (if applicable)"
          },
          "note": {
            "type": "string",
            "description": "Additional context or warnings"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "General observations about the environment"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Warnings or things to be aware of"
    }
  }
}
