#
# Build-Index - Validate knowledge domain index.yaml files
#
# This script checks that all asset files are listed in their domain's index.yaml.
# For full index generation with metadata, use: go run ./cmd/gen-index from devlore-cli.
#
# Usage:
#   ./scripts/Build-Index [--check]
#
# Options:
#   --check   Check mode (default) - verify all files are indexed
#
# The index.yaml format supports metadata for discovery:
#   prompts:
#     - name: example.txt
#       purpose: semantic-key
#       description: Human-readable description

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
KNOWLEDGE_DIR="$REPO_ROOT/knowledge"

# Asset types to check (subdirectory names)
ASSET_TYPES=(prompts schemas examples transforms signatures slots)

exit_code=0

# Check if a file is listed in the index
# Supports both simple format (- filename) and structured format (- name: filename)
file_in_index() {
    local index_file="$1"
    local filename="$2"

    # Check for structured format: "name: filename"
    if grep -q "name: $filename" "$index_file" 2>/dev/null; then
        return 0
    fi
    # Check for simple format: "- filename"
    if grep -q "^[[:space:]]*- $filename$" "$index_file" 2>/dev/null; then
        return 0
    fi
    return 1
}

# Process each knowledge domain
for domain_path in "$KNOWLEDGE_DIR"/*/; do
    [[ -d "$domain_path" ]] || continue
    domain=$(basename "$domain_path")
    index_file="$domain_path/index.yaml"

    # Check index exists
    if [[ ! -f "$index_file" ]]; then
        echo "ERROR: $domain/index.yaml does not exist" >&2
        exit_code=1
        continue
    fi

    # Check each asset type
    for asset_type in "${ASSET_TYPES[@]}"; do
        asset_dir="$domain_path/$asset_type"
        [[ -d "$asset_dir" ]] || continue

        # List files in directory
        while IFS= read -r -d '' file; do
            filename=$(basename "$file")
            [[ "$filename" == .* ]] && continue  # skip hidden files

            if ! file_in_index "$index_file" "$filename"; then
                echo "ERROR: $domain/$asset_type/$filename not in index.yaml" >&2
                exit_code=1
            fi
        done < <(find "$asset_dir" -maxdepth 1 -type f -print0 2>/dev/null)
    done
done

if [[ $exit_code -eq 0 ]]; then
    echo "All files are indexed"
else
    echo "" >&2
    echo "To regenerate indexes with metadata, run from devlore-cli:" >&2
    echo "  go run ./cmd/gen-index --registry=$REPO_ROOT" >&2
fi

exit $exit_code
