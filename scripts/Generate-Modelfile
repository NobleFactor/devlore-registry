#!/usr/bin/env bash
# SPDX-License-Identifier: SSPL-1.0
# Copyright (c) 2025-2026 Noble Factor. All rights reserved.
#
# Generate-Modelfile - Generate an Ollama Modelfile from knowledge base
#
# This script assembles knowledge files into an Ollama Modelfile with a
# comprehensive SYSTEM prompt for migration analysis.
#
# Usage:
#   ./scripts/Generate-Modelfile [--domain <domain>] [--model <model>] [--output <file>]
#
# Options:
#   --domain    Knowledge domain to use (default: migration)
#   --model     Base model (default: qwen3:8b)
#   --output    Output file (default: stdout)
#
# Example:
#   ./scripts/Generate-Modelfile --domain migration --model qwen3:8b --output devlore-migrate.Modelfile

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
KNOWLEDGE_DIR="$REPO_ROOT/knowledge"

# Defaults
DOMAIN="migration"
MODEL="qwen3:8b"
OUTPUT=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --domain)
            DOMAIN="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        --output)
            OUTPUT="$2"
            shift 2
            ;;
        -h|--help)
            sed -n '2,/^$/p' "$0" | sed 's/^# //' | sed 's/^#//'
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

DOMAIN_DIR="$KNOWLEDGE_DIR/$DOMAIN"

if [[ ! -d "$DOMAIN_DIR" ]]; then
    echo "Error: Knowledge domain not found: $DOMAIN_DIR" >&2
    exit 1
fi

# Function to output (to file or stdout)
output() {
    if [[ -n "$OUTPUT" ]]; then
        echo "$@" >> "$OUTPUT"
    else
        echo "$@"
    fi
}

# Clear output file if specified
if [[ -n "$OUTPUT" ]]; then
    > "$OUTPUT"
fi

# Start Modelfile
output "# Generated Modelfile for domain: $DOMAIN"
output "# Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
output "# Source: $DOMAIN_DIR"
output ""
output "FROM $MODEL"
output ""
output 'SYSTEM """'

# Include main prompt if exists
PROMPT_FILE="$DOMAIN_DIR/prompts/migrate-to-writ.txt"
if [[ -f "$PROMPT_FILE" ]]; then
    output "# === MAIN PROMPT ==="
    output ""
    cat "$PROMPT_FILE" | while IFS= read -r line; do
        output "$line"
    done
    output ""
fi

# Include concepts
CONCEPTS_DIR="$DOMAIN_DIR/concepts"
if [[ -d "$CONCEPTS_DIR" ]]; then
    output "# === CONCEPTS ==="
    output ""
    for file in "$CONCEPTS_DIR"/*.yaml; do
        if [[ -f "$file" ]]; then
            output "## $(basename "$file" .yaml)"
            output ""
            output '```yaml'
            cat "$file" | while IFS= read -r line; do
                output "$line"
            done
            output '```'
            output ""
        fi
    done
fi

# Include signatures
SIGNATURES_DIR="$DOMAIN_DIR/signatures"
if [[ -d "$SIGNATURES_DIR" ]]; then
    output "# === DETECTION SIGNATURES ==="
    output ""
    for file in "$SIGNATURES_DIR"/*.yaml; do
        if [[ -f "$file" ]]; then
            output "## $(basename "$file" .yaml) signature"
            output ""
            output '```yaml'
            cat "$file" | while IFS= read -r line; do
                output "$line"
            done
            output '```'
            output ""
        fi
    done
fi

# Include transforms
TRANSFORMS_DIR="$DOMAIN_DIR/transforms"
if [[ -d "$TRANSFORMS_DIR" ]]; then
    output "# === TRANSFORM RULES ==="
    output ""
    for file in "$TRANSFORMS_DIR"/*.yaml; do
        if [[ -f "$file" ]]; then
            output "## $(basename "$file" .yaml)"
            output ""
            output '```yaml'
            cat "$file" | while IFS= read -r line; do
                output "$line"
            done
            output '```'
            output ""
        fi
    done
fi

# Include examples
EXAMPLES_DIR="$DOMAIN_DIR/examples"
if [[ -d "$EXAMPLES_DIR" ]]; then
    output "# === FEW-SHOT EXAMPLES ==="
    output ""
    for file in "$EXAMPLES_DIR"/*.yaml; do
        if [[ -f "$file" ]]; then
            # Skip the baseline file we created
            [[ "$(basename "$file")" == "baseline-"* ]] && continue
            output "## Examples from $(basename "$file" .yaml)"
            output ""
            output '```yaml'
            cat "$file" | while IFS= read -r line; do
                output "$line"
            done
            output '```'
            output ""
        fi
    done
fi

# Include schema
SCHEMA_FILE="$DOMAIN_DIR/schemas/migration-plan.json"
if [[ -f "$SCHEMA_FILE" ]]; then
    output "# === OUTPUT SCHEMA ==="
    output ""
    output "You MUST respond with valid JSON matching this schema:"
    output ""
    output '```json'
    cat "$SCHEMA_FILE" | while IFS= read -r line; do
        output "$line"
    done
    output '```'
    output ""
fi

# Close SYSTEM prompt
output '"""'
output ""

# Add parameters
output "PARAMETER temperature 0.1"
output "PARAMETER num_ctx 32768"
output "PARAMETER stop \"}\""
output ""

# Summary
if [[ -n "$OUTPUT" ]]; then
    echo "Generated: $OUTPUT" >&2
    echo "Model: $MODEL" >&2
    echo "Domain: $DOMAIN" >&2
    wc -l < "$OUTPUT" | xargs -I {} echo "Lines: {}" >&2
fi
