{
  "product": {
    "name": "MacPorts",
    "canonical_name": "macports",
    "category": "package-manager",
    "vendor": "The MacPorts Project",
    "version": "2.11.6",
    "license": "BSD"
  },
  "sources": {
    "homepage": "https://www.macports.org",
    "installation": ["https://www.macports.org/install.php"],
    "upgrade": ["https://www.macports.org/install.php"],
    "uninstall": [],
    "troubleshooting": ["https://trac.macports.org/wiki/FAQ"],
    "repository": "https://github.com/macports/macports-base",
    "releases": "https://github.com/macports/macports-base/releases"
  },
  "platforms": {
    "darwin": {
      "supported": true, 
      "architectures": ["arm64", "x86_64"], 
      "notes": "Supports macOS from Leopard (10.5) to Tahoe (v26) with version-specific .pkg installers. Requires Command Line Developer Tools."
    },
    "linux": {
      "supported": true, 
      "distributions": ["experimental POSIX-compliant platforms"], 
      "notes": "Experimental support exists but requires source installation. Not actively pursued development goal."
    },
    "windows": {
      "supported": false, 
      "min_version": null, 
      "notes": "macOS-focused project, no Windows support"
    }
  },
  "complexity": {
    "rating": "complex",
    "concerns": [
      "OS upgrade requires migration procedures",
      "Version-specific installers for each macOS version",
      "Xcode Command Line Tools dependency",
      "Optional Xcode full installation for some ports",
      "X11 environment may be needed for some ports",
      "Manual shell environment configuration for source installs",
      "Xcode license acceptance required"
    ]
  },
  "next_urls_to_fetch": [
    "https://guide.macports.org",
    "https://trac.macports.org/wiki/FAQ",
    "https://trac.macports.org/wiki/Migration",
    "https://guide.macports.org/#installing.macports.uninstalling",
    "https://trac.macports.org/wiki/ProblemHotlist",
    "https://github.com/macports/macports-base/releases/download/v2.11.6/MacPorts-2.11.6.chk.txt"
  ]
}
