{
  "product": {
    "name": "MacPorts",
    "canonical_name": "macports",
    "category": "package-manager",
    "vendor": "The MacPorts Project",
    "version": "2.11.6",
    "license": "BSD"
  },
  "sources": {
    "homepage": "https://www.macports.org",
    "installation": ["https://www.macports.org/install.php"],
    "upgrade": ["https://trac.macports.org/wiki/Migration"],
    "uninstall": ["https://guide.macports.org/#installing.macports.uninstalling"],
    "troubleshooting": ["https://trac.macports.org/wiki/ProblemHotlist", "https://guide.macports.org/#installing.macports.troubleshooting"],
    "repository": "https://github.com/macports/macports-base",
    "releases": "https://github.com/macports/macports-base/releases"
  },
  "platforms": {
    "darwin": {
      "supported": true, 
      "architectures": ["arm64", "x86_64"], 
      "notes": "Supports macOS versions from Leopard to Tahoe (v26), version-specific .pkg installers available"
    },
    "linux": {
      "supported": true, 
      "distributions": ["experimental POSIX-compliant platforms"], 
      "notes": "Experimental support, requires source installation, not actively pursued"
    },
    "windows": {
      "supported": false, 
      "min_version": null, 
      "notes": "Not supported, macOS and POSIX platforms only"
    }
  },
  "complexity": {
    "rating": "complex",
    "concerns": [
      "OS upgrade requires migration to new major macOS releases",
      "Version-specific installers for different macOS versions",
      "Xcode Command Line Tools dependency required",
      "Optional Xcode full installation for some ports",
      "X11 environment dependency for some ports",
      "Manual environment configuration needed for source installation",
      "Xcode EULA acceptance required"
    ]
  },
  "next_urls_to_fetch": [
    "https://trac.macports.org/wiki/Migration",
    "https://guide.macports.org",
    "https://trac.macports.org/wiki/ProblemHotlist",
    "https://github.com/macports/macports-base",
    "https://guide.macports.org/#installing.macports.uninstalling",
    "https://guide.macports.org/#installing.macports.troubleshooting"
  ]
}
